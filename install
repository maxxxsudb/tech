  - name: GF_PLUGINS_PREINSTALL_SYNC
    value: "tech-ai-assistant-app@0.9.3@https://raw.githubusercontent.com/maxxxsudb/tech/codex/image-to-text-setting/output/tech-ai-assistant-app-0.9.3.zip"
  - name: GF_PLUGINS_ALLOW_LOADING_UNSIGNED_PLUGINS
    value: "tech-ai-assistant-app"


spec:
  template:
    spec:
      containers:
        - name: grafana
          env:
            - name: SSL_CERT_DIR
              value: /etc/grafana/custom-ca
          volumeMounts:
            - name: internal-ca
              mountPath: /etc/grafana/custom-ca
              readOnly: true
      volumes:
        - name: internal-ca
          configMap:
            name: grafana-internal-ca



apiVersion: apps/v1
kind: Deployment
metadata:
  name: grafana-plugin-tools
spec:
  selector:
    matchLabels:
      app: grafana-plugin-tools
  template:
    metadata:
      labels:
        app: grafana-plugin-tools
    spec:
      containers:
        - name: tools
          image: grafana/grafana:13.0.2
          command: ["/bin/sh", "-c", "while :; do sleep 3600; done"]
          volumeMounts:
            - name: plugins
              mountPath: /var/lib/grafana/plugins
      volumes:
        - name: plugins
          persistentVolumeClaim:
            claimName: grafana-plugin
